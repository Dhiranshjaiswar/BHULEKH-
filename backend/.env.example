# =============================================================================
# BHULEKH LEDGER & AI LAND INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================

# LLM Provider Configuration
# Supported Options: "gemini" (Google), "openai", "groq", or "none"
# If left as "none" or if no LLM_API_KEY is supplied, BHULEKH runs 100% locally
# with high-precision deterministic rule-based explanations and zero crashes!
LLM_PROVIDER=gemini

# Your LLM Provider API Key (Keep secret! Do not commit real keys)
LLM_API_KEY=your_api_key_here

# Specific LLM Model Name (Optional, defaults apply if omitted)
# Gemini: gemini-1.5-flash or gemini-1.5-pro
# OpenAI: gpt-4o-mini or gpt-4o
# Groq: llama-3.1-8b-instant
LLM_MODEL=gemini-1.5-flash

# Optional: Host OCR Path (if Tesseract binary is located in a custom directory)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
